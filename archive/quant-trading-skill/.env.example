# A股数据源 (Tushare Token，可选，用于更详细的A股数据)
TUSHARE_TOKEN=your_tushare_token_here

# 新闻API (NewsAPI Key，用于全球财经新闻)
NEWSAPI_KEY=your_newsapi_key_here

# 邮件提醒配置
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_auth_code
EMAIL_TO=your_email@qq.com

# 关注标的 (逗号分隔)
A_SHARE_WATCHLIST=000001.SZ,000002.SZ,600519.SS,002594.SZ,300750.SZ
US_STOCK_WATCHLIST=AAPL,TSLA,NVDA,MSFT,GOOGL

# 策略参数
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MA_SHORT=5
MA_MEDIUM=20
MA_LONG=60
STOP_LOSS_ATR_MULTIPLIER=2.0
TAKE_PROFIT_ATR_MULTIPLIER=3.0

# 数据存储路径
DATA_DIR=./data/daily
REPORT_DIR=./data/reports
