# 邮件服务配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_auth_code
ALERT_RECIPIENTS=recipient1@example.com,recipient2@example.com

# OpenAI 中文翻译（可选）
# 设置 NEWS_TRANSLATE=true 后，新闻日报会把英文新闻翻译成中文
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
NEWS_TRANSLATE=true

# 微信推送（可选，二选一或都配置）
# 企业微信群机器人 Webhook
WECHAT_WEBHOOK_URL=
# Server酱 SendKey（https://sct.ftqq.com）
SERVERCHAN_SENDKEY=
NEWS_PUSH_MAX_CHARS=6000

# 官方新闻源（可选，优先于页面抓取）
# NewsAPI：https://newsapi.org 注册获取 key
NEWSAPI_KEY=your_newsapi_key
NEWSAPI_LANGUAGE=en
NEWSAPI_CATEGORY=business
# Tushare Pro：https://tushare.pro 注册获取 token（新闻接口需要积分）
TUSHARE_TOKEN=your_tushare_token
NEWS_OFFICIAL_FIRST=true

# 数据源配置
YAHOO_PROXY=
AKSHARE_TIMEOUT=30

# 报告配置
REPORT_OUTPUT_DIR=./reports
REPORT_TEMPLATE_DIR=./templates

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/quant_trading.log
